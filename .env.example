# ============================================================
#  BELC Sambrial - settings file
#  1) Copy this file and rename the copy to  .env
#  2) Put your own values after the = sign
#  3) NEVER upload the real .env to GitHub (it is already in .gitignore)
# ============================================================

# --- AI chatbot + voice input (free key: https://aistudio.google.com/apikey) ---
# Leave as is and the chatbot still works, it just answers with a WhatsApp message.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: change the AI model here if Google renames/retires it
# GEMINI_MODEL="gemini-3.5-flash"
# GEMINI_TRANSCRIBE_MODEL="gemini-3.5-flash"

# --- Admission form e-mails (Gmail) ---
# Needs a Gmail "App Password" (16 letters), NOT your normal Gmail password. See README step 6.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="mqtaiyabi@gmail.com"
SMTP_PASSWORD="YOUR_APP_PASSWORD_HERE"
CONTACT_EMAIL="mqtaiyabi@gmail.com"

# --- Admin page (open  /admin  on your site and type this key to see all enquiries) ---
# Choose a long random password. If empty, the admin page is switched off.
ADMIN_KEY=""

# --- Optional ---
# PORT=3000
# DATA_DIR="./data"      # where the SQLite database file is stored
